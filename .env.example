# apps/auth-service
DATABASE_URL=postgres://user:pass@ep-xxxx.neon.tech/cloudstore?sslmode=require
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379
JWT_SECRET=<a long random string - generate with: openssl rand -hex 32>
PORT=4001

# apps/file-service
# DATABASE_URL: same Postgres database as auth-service
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=cloudstore
STORAGE_ACCESS_KEY_ID=<from R2 API token>
STORAGE_SECRET_ACCESS_KEY=<from R2 API token>
# PORT=4002

# apps/gateway — add:
# AUTH_SERVICE_URL=http://localhost:4001
FILE_SERVICE_URL=http://localhost:4002
# JWT_SECRET must match auth-service's exactly
